# ==========================================
# Mandate Resurrection Agent - Configuration
# ==========================================

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Secret used to sign the short-lived JWTs for customer scheduling links.
JWT_SECRET=super-secret-demo-key-123

# OIDC Identity Provider (e.g. Auth0) for the Merchant Dashboard.
# Leave blank to fallback to the MOCK_MERCHANT_TOKENS dictionary.
OIDC_ISSUER=
OIDC_AUDIENCE=

# ------------------------------------------
# Database & Scheduler
# ------------------------------------------
# Connection string for the primary transactional database.
# Default is SQLite for local demo. Swap to postgresql:// for production.
DATABASE_URL=sqlite:///./test.db

# ------------------------------------------
# External APIs (Razorpay)
# ------------------------------------------
# If provided, the system will hit real Razorpay endpoints instead of the simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------
# External APIs (WhatsApp / Twilio)
# ------------------------------------------
# Credentials for sending WhatsApp nudges via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Template SIDs for the Meta/WhatsApp approved templates.
WHATSAPP_SID_INSUFFICIENT_FUNDS=
WHATSAPP_SID_BANK_OUTAGE=
WHATSAPP_SID_GENERIC_RETRY=
